# Example environment file for trader.service.prod
# Copy to scripts/trader.env and edit, then secure (chmod 600)

# Kraken API credentials (required for live trading)
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# Enable live order execution
EXECUTE_ORDERS=1

# Total capital available to algorithm (USD)
TOTAL_CAPITAL=1000.0

# Optional: other flags
# RUN_TRADER_EXECUTE_ORDERS=1
