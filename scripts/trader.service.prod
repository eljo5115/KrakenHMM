[Unit]
Description=KrakenHMM Trader (production)
After=network.target

[Service]
Type=simple
User=eli
Group=eli
WorkingDirectory=/home/eli/KrakenHMM
# Use an environment file to store secrets and flags (not checked into git)
EnvironmentFile=/home/eli/KrakenHMM/scripts/trader.env
ExecStart=/home/eli/KrakenHMM/.venv/bin/python -u /home/eli/KrakenHMM/run_trader.py --http-port 8765 --trade-log-dir /home/eli/KrakenHMM/logs --trade-log-file "" --seed-history --seed-days 365
Restart=on-failure
RestartSec=5
StandardOutput=append:/home/eli/KrakenHMM/logs/trader.out
StandardError=append:/home/eli/KrakenHMM/logs/trader.out

[Install]
WantedBy=multi-user.target
