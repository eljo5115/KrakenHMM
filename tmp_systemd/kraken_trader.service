[Unit]
Description=KrakenHMM Trader (kraken_trader)
After=network.target

[Service]
Type=simple
User=eli
Group=eli
WorkingDirectory=/home/eli/KrakenHMM
# Use an environment file to store secrets and flags (not checked into git)
EnvironmentFile=/home/eli/KrakenHMM/scripts/trader.env
ExecStart=/home/eli/KrakenHMM/.venv/bin/python -u /home/eli/KrakenHMM/run_trader.py --http-port 8765 --enable-api --trade-log-dir /home/eli/KrakenHMM/logs --trade-log-file "" --seed-history --seed-days 365 --n-assets 2 --pairs "XBT/USD,ETH/USD"
Restart=always
RestartSec=5
StandardOutput=append:/home/eli/KrakenHMM/logs/trader.out
StandardError=append:/home/eli/KrakenHMM/logs/trader.out

[Install]
WantedBy=multi-user.target
